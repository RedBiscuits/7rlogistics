									"        pm.environment.set(\"auth_token\", jsonData.data.token);",
									"        pm.environment.set(\"driver_id\", jsonData.data.user.id);",
									"        pm.environment.set(\"username\", jsonData.data.user.username);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
